@model Template.Core.Models.Roles.RoleViewModel

@{
    ViewData["Title"] = "Role Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-danger mb-0">Role: @Model.Name</h3>
        <p class="text-muted mb-0">Security Role Profile & Assigned Permissions</p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="ti ti-edit me-1"></i> Edit Role
        </a>
        <a asp-action="Index" class="btn btn-light ms-1">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3">Role Overview</h5>
                <p class="mb-2"><strong>Name:</strong> @Model.Name</p>
                <p class="mb-2">
                    <strong>Status:</strong>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </p>
                <p class="mb-2"><strong>Assigned Users:</strong> <span class="badge bg-light text-dark border">@Model.AssignedUsersCount Users</span></p>
                <p class="mb-0"><strong>Created On:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd")</p>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3">Role Description</h5>
                <p class="text-muted mb-0">@(Model.Description ?? "No explicit description provided for this security role.")</p>
            </div>
        </div>
    </div>
</div>