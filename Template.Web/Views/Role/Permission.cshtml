@model Template.Core.Models.Permissions.RolePermissionsViewModel

@{
    ViewData["Title"] = $"Permissions - {Model.RoleName}";
}

<form asp-action="Permissions" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RoleId" />
    <input type="hidden" asp-for="RoleName" />

    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold text-danger">Configure Permissions</h3>
                <p class="text-muted mb-0">Assigning capabilities for role: <strong>@Model.RoleName</strong></p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                <button type="submit" class="btn btn-danger">
                    <i class="ti ti-device-floppy me-1"></i> Save Changes
                </button>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                @for (int i = 0; i < Model.Permissions.Count; i++)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="border rounded p-3 h-100">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       asp-for="Permissions[i].IsSelected"
                                       id="perm_@i" />

                                <input type="hidden" asp-for="Permissions[i].Name" />
                                <input type="hidden" asp-for="Permissions[i].DisplayName" />

                                <label class="form-check-label fw-semibold text-dark" for="perm_@i">
                                    @Model.Permissions[i].DisplayName
                                </label>
                                <br />
                                <small class="text-muted font-monospace">@Model.Permissions[i].Name</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</form>