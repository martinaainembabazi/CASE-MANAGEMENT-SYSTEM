@model IEnumerable<Template.Core.Models.Roles.RoleViewModel>

@{
    ViewData["Title"] = "Role Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-danger mb-0">Role Management</h3>
        <p class="text-muted mb-0">Manage system security roles, access levels, and permissions.</p>
    </div>
    <a asp-action="Create" class="btn btn-danger">
        <i class="ti ti-plus me-1"></i> Create New Role
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Role Name</th>
                        <th>Description</th>
                        <th>Assigned Users</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No security roles registered yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@role.Name</td>
                                <td>@(role.Description ?? "N/A")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@role.AssignedUsersCount Users</span>
                                </td>
                                <td>
                                    @if (role.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@role.Id" class="btn btn-outline-secondary" title="View Details">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-outline-primary" title="Edit Role">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@role.Id" class="btn btn-outline-danger" title="Deactivate Role">
                                            <i class="ti ti-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>