@model IEnumerable<Template.Core.Models.Roles.ApplicationRoleViewModel>

@{
    ViewData["Title"] = "Roles & Rights";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-danger">Role & Access Management</h3>
            <p class="text-muted mb-0">Define user roles and assign fine-grained action permissions.</p>
        </div>
        <a asp-action="Create" class="btn btn-danger">
            <i class="ti ti-plus me-1"></i> Add New Role
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Role Name</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model)
                    {
                        <tr>
                            <td>
                                <strong>@role.Name</strong>
                            </td>
                            <td>@role.Description</td>
                            <td class="text-end">
                                <a asp-action="Permissions" asp-route-roleId="@role.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="ti ti-lock me-1"></i> Configure Rights
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>