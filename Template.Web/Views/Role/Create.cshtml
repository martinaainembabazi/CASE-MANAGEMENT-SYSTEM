@model RoleListViewModel
@{
    ViewData["Title"] = "Create Role";
}


<div class="d-flex justify-content-end align-items-center mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h2>Create Role</h2>
                    <h6 class="card-subtitle my-1 text-body-secondary">Role Details</h6>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-floating mb-3">
                        <input type="text" asp-for="Name" class="form-control"
                               placeholder="Username" required>
                        <label asp-for="Name">Role Name</label>
                        <small class="form-text text-muted">
                            Role names should be concise and descriptive of the permissions they will contain.
                        </small>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    @* <div class="mb-3">
                    <label asp-for="Name" class="form-label">Role Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter role name (e.g. Admin, Editor, User)" autofocus />
                    <span asp-validation-for="Name" class="text-danger"></span>
                    <div class="form-text">Role names should be concise and descriptive of the permissions they will contain.</div>
                    </div> *@

                    <button type="submit" class="btn btn-success">
                        <i class="ti ti-folder me-1"></i> Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}