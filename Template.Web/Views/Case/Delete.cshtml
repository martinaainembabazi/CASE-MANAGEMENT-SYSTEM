@model Template.Core.Models.Cases.CaseViewModel

@{
    ViewData["Title"] = "Delete Case";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-danger mb-0">Delete Case Record</h3>
        <p class="text-muted mb-0">Confirm the removal of this legal matter from active files.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="fw-bold mb-0"><i class="ti ti-alert-triangle me-2"></i> Warning: Permanent Action</h5>
            </div>
            <div class="card-body p-4">
                <p class="fs-6">
                    Are you sure you want to delete case <strong>#@Model.Id - @Model.Title</strong>?
                </p>

                <div class="bg-light p-3 rounded border mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Case Type</label>
                            <p class="fw-bold mb-0">@Model.TypeName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Current Status</label>
                            <p class="fw-bold mb-0">@Model.StatusName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Date Created</label>
                            <p class="fw-bold mb-0">@Model.DateCreated.ToString("yyyy-MM-dd")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Created By</label>
                            <p class="fw-bold mb-0">@Model.CreatedByName</p>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="col-12">
                                <label class="text-muted small fw-semibold">Summary</label>
                                <p class="mb-0 text-secondary">@Model.Description</p>
                            </div>
                        }
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-danger">
                            <i class="ti ti-trash me-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>