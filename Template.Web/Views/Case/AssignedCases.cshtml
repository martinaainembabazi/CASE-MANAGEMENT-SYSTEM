@model IEnumerable<Template.Data.Entities.CaseAssignment>

@{
    ViewData["Title"] = "Assigned Cases";
    Layout = "_Layout"; 
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Assigned Legal Matters</h3>
            <p class="text-muted mb-0">Overview of all active and historical cases assigned to your firm.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle datatable">
                    <thead class="table-light">
                        <tr>
                            <th>REF NO</th>
                            <th>CASE TITLE</th>
                            <th>TYPE</th>
                            <th>STATUS</th>
                            <th>ASSIGNED DATE</th>
                            <th class="text-end">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No assigned cases found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#(item.Case?.Id)</td>
                                    <td>
                                        <div class="fw-semibold">@item.Case?.Title</div>
                                        <small class="text-muted">Assigned: @item.AssignedDate.ToString("dd MMM yyyy")</small>
                                    </td>
                                    <td>@(item.Case?.Type?.Name ?? "N/A")</td>
                                    <td>
                                        <span class="badge bg-soft-primary text-primary">
                                            @(item.Case?.Status?.Name ?? "Active")
                                        </span>
                                    </td>
                                    <td>@item.AssignedDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-end">
                                        <a asp-controller="Case" asp-action="Details" asp-route-id="@item.CaseId" class="btn btn-sm btn-outline-secondary">
                                            <i class="ti ti-eye me-1"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>