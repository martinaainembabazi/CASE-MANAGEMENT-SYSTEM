@model Template.Core.Models.Cases.DashboardViewModel
@{
    ViewData["Title"] = "Legal Staff Dashboard";
}

<!-- Custom Dashboard Theme Styles -->
<style>
    .bou-card-kpi {
        border: none;
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background: #ffffff;
    }

        .bou-card-kpi:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.06) !important;
        }

    .icon-shape {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .badge-soft-primary {
        background-color: #eef2ff;
        color: #3730a3;
    }

    .badge-soft-success {
        background-color: #ecfdf5;
        color: #065f46;
    }

    .badge-soft-warning {
        background-color: #fffbeb;
        color: #92400e;
    }

    .badge-soft-info {
        background-color: #f0f9ff;
        color: #075985;
    }

    .badge-soft-secondary {
        background-color: #f8fafc;
        color: #475569;
    }
</style>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="ti ti-layout-dashboard me-2 text-primary"></i>Legal Operations Dashboard</h3>
        <p class="text-muted mb-0">Overview of active legal matters, court schedules, and key metrics</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-danger shadow-sm px-3">
            <i class="ti ti-plus me-1"></i> New Legal Case
        </a>
    </div>
</div>

<!-- Key Metrics Summary Row -->
<div class="row g-3 mb-4">
    <div class="col-xl col-md-4 col-sm-6">
        <div class="card bou-card-kpi shadow-sm p-3 h-100">
            <div class="d-flex align-items-center justify-content-between h-100">
                <div>
                    <span class="text-muted fs-7 fw-bold text-uppercase tracking-wide">Total Cases</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalCases</h3>
                </div>
                <div class="icon-shape badge-soft-primary flex-shrink-0 ms-2">
                    <i class="ti ti-briefcase"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-4 col-sm-6">
        <div class="card bou-card-kpi shadow-sm p-3 h-100">
            <div class="d-flex align-items-center justify-content-between h-100">
                <div>
                    <span class="text-muted fs-7 fw-bold text-uppercase tracking-wide">Active Firms</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.ActiveAssignments</h3>
                </div>
                <div class="icon-shape badge-soft-success flex-shrink-0 ms-2">
                    <i class="ti ti-building-bank"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-4 col-sm-6">
        <div class="card bou-card-kpi shadow-sm p-3 h-100">
            <div class="d-flex align-items-center justify-content-between h-100">
                <div>
                    <span class="text-muted fs-7 fw-bold text-uppercase tracking-wide">Upcoming Hearings</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.UpcomingHearingsCount</h3>
                </div>
                <div class="icon-shape badge-soft-warning flex-shrink-0 ms-2">
                    <i class="ti ti-gavel"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-6 col-sm-6">
        <div class="card bou-card-kpi shadow-sm p-3 h-100">
            <div class="d-flex align-items-center justify-content-between h-100">
                <div>
                    <span class="text-muted fs-7 fw-bold text-uppercase tracking-wide">Fees Paid</span>
                    <h3 class="fw-bold text-dark fs-5 mb-0 mt-1">UGX @Model.TotalLegalFeesPaid.ToString("N0")</h3>
                </div>
                <div class="icon-shape badge-soft-info flex-shrink-0 ms-2">
                    <i class="ti ti-receipt-2"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-6 col-sm-6">
        <div class="card bou-card-kpi shadow-sm p-3 h-100">
            <div class="d-flex align-items-center justify-content-between h-100">
                <div>
                    <span class="text-muted fs-7 fw-bold text-uppercase tracking-wide">Total Provisions</span>
                    <h3 class="fw-bold text-dark fs-5 mb-0 mt-1">UGX @Model.TotalFinancialProvisions.ToString("N0")</h3>
                </div>
                <div class="icon-shape badge-soft-secondary flex-shrink-0 ms-2">
                    <i class="ti ti-pig-money"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recently Created Cases Table -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
        <div>
            <h5 class="card-title fw-bold mb-0">Recently Created Cases</h5>
            <span class="text-muted small">Latest legal matters entered into the system</span>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            View All Cases <i class="ti ti-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-uppercase fs-7 text-muted">
                    <tr>
                        <th class="ps-4">Title</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.RecentCases)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@c.Title</div>
                                <span class="small text-muted">Ref: CASE-@c.Id.ToString("D4")</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@(c.Type?.Name ?? "General")</span>
                            </td>
                            <td>
                                <span class="badge badge-soft-info px-2 py-1">@(c.Status?.Name ?? "Pending")</span>
                            </td>
                            <td class="text-muted fs-7">@c.DateCreated.ToString("dd MMM yyyy")</td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger px-3 rounded-pill">
                                    Manage <i class="ti ti-chevron-right ms-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Upcoming Hearings Schedule Widget -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                <h5 class="card-title fw-bold mb-0">
                    <i class="ti ti-calendar-event me-2 text-warning"></i>Upcoming Court Hearings
                </h5>
                <span class="badge badge-soft-warning px-3 py-1 rounded-pill">Next 5 Scheduled</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-uppercase fs-7 text-muted">
                            <tr>
                                <th class="ps-4">Date & Time</th>
                                <th>Case Title</th>
                                <th>Court / Judge</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.UpcomingHearings.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No upcoming hearings scheduled.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var h in Model.UpcomingHearings)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@h.HearingDate.ToString("dd MMM yyyy")</div>
                                            <span class="badge bg-light text-muted border"><i class="ti ti-clock me-1"></i>@h.HearingDate.ToString("HH:mm")</span>
                                        </td>
                                        <td class="fw-semibold text-dark">@h.CaseTitle</td>
                                        <td>
                                            <div class="text-dark fw-medium">@h.CourtLocation</div>
                                            <small class="text-muted">@h.JudgeOrMagistrate</small>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-action="Details" asp-route-id="@h.CaseId" class="btn btn-sm btn-light border px-3 rounded-pill">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- System Notifications / Activity Feed Widget -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
            <div class="card-header bg-white py-3 border-bottom-0">
                <h5 class="card-title fw-bold mb-0">
                    <i class="ti ti-bell me-2 text-primary"></i>System Notifications & Updates
                </h5>
            </div>
            <div class="card-body pt-0">
                @if (!Model.Notifications.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="ti ti-bell-off fs-2 mb-2 d-block text-secondary"></i>
                        No recent system notifications.
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var n in Model.Notifications)
                        {
                            <div class="list-group-item px-0 py-3 border-bottom">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="badge @n.BadgeClass me-2"><i class="@n.IconClass me-1"></i>@n.Title</span>
                                    <small class="text-muted ms-auto fs-7">@n.Timestamp.ToString("dd MMM HH:mm")</small>
                                </div>
                                <p class="mb-0 small text-secondary lh-sm mt-2">@n.Message</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>