@model Template.Core.Models.Cases.CaseViewModel

@{
    ViewData["Title"] = $"Case #{Model.Id} Details";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-danger">@Model.Title</h3>
            <p class="text-muted mb-0">Case Ref: <strong>#@Model.Id</strong> | Type: <strong>@Model.TypeName</strong> | Status: <strong>@Model.StatusName</strong></p>
        </div>
        <div class="d-flex gap-2">
            <!-- Action to upload/attach a new document or file to THIS specific case -->
            <a asp-controller="Document" asp-action="Upload" asp-route-caseId="@Model.Id" class="btn btn-outline-danger">
                <i class="ti ti-paperclip me-1"></i> Add Case File
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">
                <i class="ti ti-edit me-1"></i> Edit Case
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Case Overview Card -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title fw-bold mb-0">Case Summary</h5>
            </div>
            <div class="card-body">
                <p>@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
            </div>
        </div>

        <!-- Attached Documents / Case Files Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0">Attached Files & Documents (@Model.DocumentCount)</h5>
                <a asp-controller="Document" asp-action="Upload" asp-route-caseId="@Model.Id" class="btn btn-sm btn-danger">
                    <i class="ti ti-upload me-1"></i> Upload File
                </a>
            </div>
            <div class="card-body">
                @if (Model.DocumentCount == 0)
                {
                    <p class="text-muted mb-0">No files uploaded for this case yet.</p>
                }
                else
                {
                    <!-- Document list goes here -->
                    <p class="text-success mb-0"><i class="ti ti-file me-1"></i> File attachments loaded.</p>
                }
            </div>
        </div>
    </div>

    <!-- Metadata Sidebar Card -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
                <h5 class="card-title fw-bold mb-0">Case Info</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Date Created:</span>
                        <span class="fw-semibold">@Model.DateCreated.ToString("yyyy-MM-dd")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Created By:</span>
                        <span class="fw-semibold">@Model.CreatedByName</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Hearings:</span>
                        <span class="badge bg-primary">@Model.HearingCount</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Assignments:</span>
                        <span class="badge bg-secondary">@Model.AssignmentCount</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>