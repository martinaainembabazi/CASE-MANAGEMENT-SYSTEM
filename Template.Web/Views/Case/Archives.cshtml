@model IEnumerable<Template.Core.Models.Cases.CaseViewModel>

@{
    ViewData["Title"] = "Archived Cases";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Case Archives</h3>
        <p class="text-muted small mb-0">View and retrieve closed or archived cases on a needs basis.</p>
    </div>
</div>

<!-- Search Bar -->
<form method="get" asp-action="Archives" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchTerm" class="form-control" placeholder="Search archived cases by title..." value="@Context.Request.Query["searchTerm"]" />
        <button class="btn btn-outline-secondary" type="submit">
            <i class="ti ti-search me-1"></i> Search
        </button>
    </div>
</form>

<!-- Table List -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ref ID</th>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No archived cases found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td class="fw-bold">@item.Title</td>
                                <td>@item.TypeName</td>
                                <td><span class="badge bg-secondary">@item.StatusName</span></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="ti ti-eye me-1"></i> View
                                    </a>
                                    <form asp-action="UnarchiveCase" asp-controller="Case" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="caseId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="ti ti-archive-off me-1"></i> Retrieve
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>