@model Template.Core.Models.Cases.CreateCaseViewModel

@{
    ViewData["Title"] = "Create New Case";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-danger">Create New Legal Case</h3>
            <p class="text-muted mb-0">Register a new litigation file or legal matter in the system.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Back to Cases
            </a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <!-- Title -->
                <div class="col-md-12">
                    <label asp-for="Title" class="form-label fw-bold">Case Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Bank of Uganda vs. Acme Corporation" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <!-- Case Type -->
                <div class="col-md-6">
                    <label asp-for="TypeId" class="form-label fw-bold">Case Type <span class="text-danger">*</span></label>
                    <select asp-for="TypeId" asp-items="Model.TypeOptions" class="form-select">
                        <option value="">-- Select Case Type --</option>
                    </select>
                    <span asp-validation-for="TypeId" class="text-danger"></span>
                </div>

                <!-- Case Status -->
                <div class="col-md-6">
                    <label asp-for="StatusId" class="form-label fw-bold">Initial Status <span class="text-danger">*</span></label>
                    <select asp-for="StatusId" asp-items="Model.StatusOptions" class="form-select">
                        <option value="">-- Select Status --</option>
                    </select>
                    <span asp-validation-for="StatusId" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="col-md-12">
                    <label asp-for="Description" class="form-label fw-bold">Case Description / Summary</label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Provide background details or summary of the matter..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-danger">
                    <i class="ti ti-check me-1"></i> Save Case
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}