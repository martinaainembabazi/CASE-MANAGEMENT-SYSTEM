@model Template.Core.Models.Account.ApplicationUserViewModel

@{
    ViewData["Title"] = "Delete User Account";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-danger mb-0">Delete User Account</h3>
        <p class="text-muted mb-0">Confirm permanent or soft removal of user access from the system.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="fw-bold mb-0"><i class="ti ti-alert-triangle me-2"></i> Warning: Deleting Account</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-secondary fs-6">
                    Are you sure you want to delete the user account for 
                    <strong class="text-dark">@(string.IsNullOrEmpty(Model.FullName) ? Model.UserName : Model.FullName)</strong>?
                </p>

                <div class="bg-light p-3 rounded border mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Username</label>
                            <p class="fw-bold mb-0">@Model.UserName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Email</label>
                            <p class="fw-bold mb-0">@(Model.Email ?? "N/A")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Designation</label>
                            <p class="fw-bold mb-0">@(Model.Title ?? "N/A")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">Assigned Roles</label>
                            <p class="fw-bold mb-0">
                                @(Model.SelectedRoles != null && Model.SelectedRoles.Any() 
                                    ? string.Join(", ", Model.SelectedRoles) 
                                    : "None")
                            </p>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-danger">
                            <i class="ti ti-trash me-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>