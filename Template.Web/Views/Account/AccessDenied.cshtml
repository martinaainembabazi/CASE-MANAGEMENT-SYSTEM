@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center py-5">
    <div class="card border-0 shadow-sm mx-auto p-4" style="max-width: 500px; border-radius: 12px;">
        <div class="text-danger mb-3">
            <i class="ti ti-shield-lock" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold text-dark">Access Denied</h3>
        <p class="text-muted fs-7 mb-4">
            You do not have permission to view this resource. Please log in with an authorized external law firm account.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-3">Go to Home</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-danger px-3">Switch Account</a>
        </div>
    </div>
</div>