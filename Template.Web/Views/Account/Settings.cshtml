@model Template.ViewModels.UserAccountSettingsViewModel
@{
    ViewData["Title"] = "Account Settings";
}

<div class="container-fluid px-4 py-3">
    <!-- Top Header & Logout -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark"><i class="ti ti-user-gear me-2 text-danger"></i>Account Settings</h3>
            <p class="text-muted mb-0">Manage your profile details and security settings</p>
        </div>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm px-3 shadow-sm d-flex align-items-center gap-1">
                <i class="ti ti-logout fs-5"></i>
                <span>Logout</span>
            </button>
        </form>
    </div>

    <div class="row g-4">
        <!-- User Profile Card -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h6 class="fw-bold mb-0 text-dark">Profile Information</h6>
                </div>
                <div class="card-body pt-0">
                    <div class="p-3 bg-light rounded-3 mb-3 text-center">
                        <div class="bg-danger text-white rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 48px; height: 48px; font-size: 1.2rem;">
                            @(Model.FullName?.FirstOrDefault() != default ? Model.FullName.Substring(0, 1).ToUpper() : "U")
                        </div>
                        <h6 class="fw-bold text-dark mb-0">@Model.FullName</h6>
                        <span class="text-muted fs-8">@@@Model.UserName</span>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                            <span class="text-muted fs-8 fw-bold text-uppercase">Email Address</span>
                            <span class="fw-semibold text-dark fs-7">@Model.Email</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                            <span class="text-muted fs-8 fw-bold text-uppercase">Job Title</span>
                            <span class="fw-semibold text-dark fs-7">@Model.JobTitle</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pb-1">
                            <span class="text-muted fs-8 fw-bold text-uppercase">Business Unit</span>
                            <span class="fw-semibold text-dark fs-7">@Model.BusinessUnit</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Change Password Card -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h6 class="fw-bold mb-0 text-dark">Security & Password</h6>
                </div>
                <div class="card-body pt-0">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fs-8"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fs-8 fw-bold text-uppercase text-muted"></label>
                            <input asp-for="CurrentPassword" class="form-control border-light-subtle" placeholder="Enter current password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger fs-8"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fs-8 fw-bold text-uppercase text-muted"></label>
                            <input asp-for="NewPassword" class="form-control border-light-subtle" placeholder="Enter new password" />
                            <span asp-validation-for="NewPassword" class="text-danger fs-8"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fs-8 fw-bold text-uppercase text-muted"></label>
                            <input asp-for="ConfirmPassword" class="form-control border-light-subtle" placeholder="Confirm new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger fs-8"></span>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-danger shadow-sm px-4">
                                <i class="ti ti-key me-1"></i> Update Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@section Styles {
    <style type="text/css">
        .fs-7 {
            font-size: 0.85rem !important;
        }

        .fs-8 {
            font-size: 0.775rem !important;
        }
    </style>
}