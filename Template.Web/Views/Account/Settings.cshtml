@model Template.ViewModels.UserAccountSettingsViewModel
@{
    ViewData["Title"] = "Account Settings";
}

<div class="container-fluid px-4 py-3">
    <h3 class="fw-bold mb-4"><i class="ti ti-user-cog me-2"></i>Account Settings</h3>

    <div class="row g-4">
        <!-- User Profile Card -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">Profile Information</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">FULL NAME</label>
                        <p class="fw-bold text-dark mb-0">@Model.FullName</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">USERNAME</label>
                        <p class="fw-bold text-dark mb-0">@Model.UserName</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">EMAIL ADDRESS</label>
                        <p class="fw-bold text-dark mb-0">@Model.Email</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">JOB TITLE</label>
                        <p class="fw-bold text-dark mb-0">@Model.JobTitle</p>
                    </div>
                    <div class="mb-0">
                        <label class="form-label text-muted small fw-semibold">BUSINESS UNIT</label>
                        <p class="fw-bold text-dark mb-0">@Model.BusinessUnit</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Change Password Card -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">Security & Password</h5>
                </div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                            <input asp-for="CurrentPassword" class="form-control" placeholder="Enter current password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                            <input asp-for="NewPassword" class="form-control" placeholder="Enter new password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-danger">
                                <i class="ti ti-key me-1"></i> Update Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}