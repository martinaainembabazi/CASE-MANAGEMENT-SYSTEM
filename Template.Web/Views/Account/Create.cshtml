@model Template.Core.Models.Account.CreateViewModel
@{
    ViewData["Title"] = "Create User Account";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h4 class="fw-bold mb-1">Create User Account</h4>
        <p class="text-muted small mb-4">Provision a new user account, assign access roles, and set initial credentials.</p>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Username Field -->
            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-semibold">Active Directory / System Username</label>
                <input asp-for="Username" class="form-control" placeholder="Enter network username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <!-- Role Selection Field -->
            <div class="mb-3">
                <label asp-for="SelectedRole" class="form-label fw-semibold">Assign System Role (Access Control)</label>
                <select asp-for="SelectedRole" asp-items="Model.AvailableRoles" class="form-select">
                    <option value="">-- Select Access Role --</option>
                </select>
                <span asp-validation-for="SelectedRole" class="text-danger"></span>
            </div>

            <!-- Password Fields -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Initial Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-danger">
                    <i class="ti ti-user-check me-1"></i> Create Account
                </button>
            </div>
        </form>
    </div>
</div>