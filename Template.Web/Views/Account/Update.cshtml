@model Template.Core.Models.Account.ApplicationUserViewModel

@{
    ViewData["Title"] = "Update User Account";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-danger mb-0">Update User Account</h3>
        <p class="text-muted mb-0">Manage information, status, and role assignments for @Model.UserName.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Update" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserName" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <!-- Profile Info Section -->
            <h5 class="fw-bold text-secondary mb-3"><i class="ti ti-user me-1"></i> User Information</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label fw-bold">Active Directory Username</label>
                    <input asp-for="UserName" class="form-control bg-light" readonly />
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                    <input asp-for="Email" class="form-control bg-light" readonly />
                </div>

                <div class="col-md-6">
                    <label asp-for="Title" class="form-label fw-bold">Title / Designation</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label fw-bold">Account End Date</label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Role Assignment Section -->
            <h5 class="fw-bold text-secondary mb-3"><i class="ti ti-shield-lock me-1"></i> Assign System Roles</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-12">
                    <div class="card bg-light border-0 p-3">
                        <label class="form-label fw-semibold mb-2">Check system permissions and roles for this user:</label>
                        <div class="row">
                            @if (Model.RoleOptions != null && Model.RoleOptions.Any())
                            {
                                @foreach (var role in Model.RoleOptions)
                                {
                                    <div class="col-md-4 mb-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role.Value"
                                                   id="role_@role.Value" @(Model.SelectedRoles != null && Model.SelectedRoles.Contains(role.Value) ? "checked" : "") />
                                            <label class="form-check-label fw-medium" for="role_@role.Value">
                                                @role.Text
                                            </label>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0 small">No system roles configured.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Status & Account Access Section -->
            <h5 class="fw-bold text-secondary mb-3"><i class="ti ti-toggle-left me-1"></i> Account Status & Access Control</h5>

            <div class="card border bg-light mb-4">
                <div class="card-body">
                    <!-- Active Status Switch -->
                    <div class="form-group mb-3">
                        <div class="form-check form-switch d-flex align-items-center">
                            <input class="form-check-input me-2" type="checkbox" asp-for="IsActive" role="switch" id="flexSwitchIsActive" style="width: 3em; height: 1.5em;" onchange="toggleLockReasonSection()">
                            <label class="form-check-label fw-medium" asp-for="IsActive">
                                <span id="statusText">
                                    <span class="badge bg-success-subtle text-success fs-6 fw-bold" id="activeText">Active Account</span>
                                    <span class="badge bg-danger-subtle text-danger fs-6 fw-bold d-none" id="inactiveText">Account Locked / Inactive</span>
                                </span>
                            </label>
                        </div>
                    </div>

                    <!-- Dynamic Lock Reason Input Field -->
                    <div class="mb-2" id="lockReasonGroup">
                        <label asp-for="LockReason" class="form-label fw-semibold text-danger">Reason for Account Lock / Deactivation</label>
                        <textarea asp-for="LockReason" class="form-control" rows="2" placeholder="Provide a reason to notify the user upon login attempt..."></textarea>
                        <span asp-validation-for="LockReason" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-danger">
                    <i class="ti ti-device-floppy me-1"></i> Save Changes
                </button>
            </div>
            </form>
            </div>
            </div>


            @section Scripts {
                <partial name="_ValidationScriptsPartial" />
                <script>
                                function toggleLockReasonSection() {
                                    const toggle = document.getElementById('flexSwitchIsActive');
                                    const activeText = document.getElementById('activeText');
                                    const inactiveText = document.getElementById('inactiveText');
                                    const lockReasonGroup = document.getElementById('lockReasonGroup');

                                    if (toggle && activeText && inactiveText && lockReasonGroup) {
                                        if (toggle.checked) {
                                            activeText.classList.remove('d-none');
                                            inactiveText.classList.add('d-none');
                                            lockReasonGroup.classList.add('d-none');
                                        } else {
                                            activeText.classList.add('d-none');
                                            inactiveText.classList.remove('d-none');
                                            lockReasonGroup.classList.remove('d-none');
                                        }
                                    }
                                }

                                // Run once DOM is loaded to set initial state correctly
                                document.addEventListener('DOMContentLoaded', toggleLockReasonSection);
                </script>
            }