	<script src="https://cdn.datatables.net/2.2.2/js/dataTables.bootstrap5.js"></script>

	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/sidebarmenu.js"></script>
	<script src="~/js/app.min.js"></script>
	<script src="~/lib/simplebar/src/simplebar.js"></script>
	<script src="~/js/dashboard.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="_framework/blazor.server.js"></script>

	<script>
		$('#categories').change(function() {
			var categoryId = $(this).val();

			if (categoryId) {
				fetch('@Url.Action("GetAllCategoryItems", "Item")?id=' + categoryId, {
					method: 'GET',
					headers: {
						'Content-Type': 'application/json'
					},
					body: null
				})
				.then(response => response.json())
				.then(data => {
					$('#items').empty();
					$('#items').append('<option value="">Select Item</option>');
					data.forEach(function(item) {
						$('#items').append('<option value="' + item.itemId + '">' + item.itemName + '</option>');
					});
				})
				.catch(error => {
					console.error("Error fetching items:", error);
				});
			}
		});
	</script>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const collapses = document.querySelectorAll('.collapse');

			collapses.forEach(collapse => {
				const collapseId = collapse.id;
				if (localStorage.getItem(collapseId) === 'shown') {
					const collapseInstance = new bootstrap.Collapse(collapse, { toggle: false });
					collapseInstance.show();
				}
			});

			collapses.forEach(collapse => {
				collapse.addEventListener('show.bs.collapse', function() {
					localStorage.setItem(this.id, 'shown');
				});

				collapse.addEventListener('hide.bs.collapse', function() {
					localStorage.removeItem(this.id);
				});
			});
		});
	</script>


	@await RenderSectionAsync("Scripts", required: false)
	@await RenderSectionAsync("Styles", required: false)
