@model InnovationDashboardModel
@{
    ViewData["Title"] = "Innovation Team Dashboard - Innovation Management Tracking System";
}

<body class="ims-staff-dashboard">
    <!-- Sidebar -->
    <aside class="ims-staff-sidebar">
        <div class="ims-staff-sidebar-brand">
            <div class="ims-staff-brand-logo"><img src="~/img/bou.png" alt="Bank of Uganda"></div>
            <div class="ims-staff-brand-text">Bank of Uganda<span>Innovation Management</span></div>
        </div>
        <ul class="ims-staff-sidebar-nav">
            <li><a asp-page="/Innovation/Dashboard" class="ims-staff-nav-active"><span class="ims-staff-nav-icon"><i data-lucide="layout-dashboard" style="width:18px;height:18px;"></i></span><span>Dashboard</span></a></li>
            <li><a asp-page="/Innovation/SubmittedIdeas"><span class="ims-staff-nav-icon"><i data-lucide="list" style="width:18px;height:18px;"></i></span><span>Submitted Ideas</span></a></li>
            <li><a asp-page="/Innovation/Categories"><span class="ims-staff-nav-icon"><i data-lucide="folder-tree" style="width:18px;height:18px;"></i></span><span>Categories</span></a></li>
            <li><a asp-page="/Staff/Resources"><span class="ims-staff-nav-icon"><i data-lucide="book-open" style="width:18px;height:18px;"></i></span><span>Resources</span></a></li>
            <li><a asp-page="/Innovation/Reports"><span class="ims-staff-nav-icon"><i data-lucide="bar-chart-3" style="width:18px;height:18px;"></i></span><span>Reports</span></a></li>
            <li><a asp-page="/Innovation/Permissions"><span class="ims-staff-nav-icon"><i data-lucide="shield" style="width:18px;height:18px;"></i></span><span>Permissions</span></a></li>
        </ul>
        <div class="ims-staff-sidebar-footer">BOU Innovation System v1.0</div>
    </aside>

    <!-- Main Content -->
    <div class="ims-staff-main-wrapper">
        <!-- Header -->
        <header class="ims-staff-top-header">
            <div class="ims-staff-header-left">
                <h2>Innovation Dashboard</h2>
            </div>
            <div class="ims-staff-header-right">
                <button class="ims-staff-notification-btn"><i data-lucide="bell" style="width:20px;height:20px;"></i><span class="ims-staff-badge-dot"></span></button>
                <div class="ims-staff-user-profile">
                    <div class="ims-staff-avatar">@User.Identity.Name?.Substring(0, 1)</div>
                    <span class="ims-staff-user-name">@User.Identity.Name</span>
                </div>
                <a class="ims-staff-logout-btn" asp-controller="Account" asp-action="Logout">Log out</a>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="ims-staff-main-content">
            <!-- Welcome Bar -->
            <div class="ims-staff-welcome-bar">
                <h1>Innovation Team Dashboard</h1>
                <p>Manage, review and track all innovation submissions</p>
            </div>

            <!-- Summary Cards -->
            <div class="ims-staff-summary-cards">
                <div class="ims-staff-summary-card">
                    <div class="ims-staff-card-label">Total Submitted Ideas</div>
                    <div class="ims-staff-card-value">@Model.Stats.TotalIdeas</div>
                    <div class="ims-staff-card-sub">All time</div>
                </div>
                <div class="ims-staff-summary-card">
                    <div class="ims-staff-card-label">Pending Reviews</div>
                    <div class="ims-staff-card-value">@Model.Stats.PendingReviews</div>
                    <div class="ims-staff-card-sub">Awaiting assessment</div>
                </div>
                <div class="ims-staff-summary-card">
                    <div class="ims-staff-card-label">Concept Development</div>
                    <div class="ims-staff-card-value">@Model.Stats.ConceptDevelopment</div>
                    <div class="ims-staff-card-sub">In progress</div>
                </div>
                <div class="ims-staff-summary-card">
                    <div class="ims-staff-card-label">Experimentation</div>
                    <div class="ims-staff-card-value">@Model.Stats.Experimentation</div>
                    <div class="ims-staff-card-sub">Being tested</div>
                </div>
                <div class="ims-staff-summary-card">
                    <div class="ims-staff-card-label">Deployment</div>
                    <div class="ims-staff-card-value">@Model.Stats.Deployment</div>
                    <div class="ims-staff-card-sub">Ready to launch</div>
                </div>
            </div>

            <!-- Two Column Grid -->
            <div class="ims-staff-two-col-grid">
                <!-- Recent Submissions -->
                <div class="ims-staff-card ims-staff-table-card">
                    <div class="ims-staff-section-header">
                        <h3>Recent Submissions</h3>
                        <a asp-page="/Innovation/SubmittedIdeas" class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-secondary">View All</a>
                    </div>
                    <div class="ims-staff-table-container">
                        <table class="ims-staff-data-table">
                            <thead>
                                <tr>
                                    <th>Idea Title</th>
                                    <th>Submitter</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var idea in Model.RecentIdeas)
                                {
                                    <tr>
                                        <td>@idea.Title</td>
                                        <td>@idea.Submitter</td>
                                        <td>
                                            <span class="ims-staff-badge ims-staff-badge-@idea.Status.Replace(" ", "-").ToLower()">
                                                @idea.Status
                                            </span>
                                        </td>
                                        <td>@idea.Date.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Review Queue -->
                <div class="ims-staff-card">
                    <div class="ims-staff-section-header">
                        <h3>Review Queue</h3>
                    </div>
                    <div class="ims-staff-review-queue">
                        @foreach (var review in Model.ReviewQueue)
                        {
                            <div class="ims-staff-review-item">
                                <span class="ims-staff-review-title">@review.Title</span>
                                <span class="ims-staff-review-status ims-staff-review-status-@review.StatusClass">
                                    @review.StatusText
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- SLA Deadlines -->
            <div class="ims-staff-card ims-staff-table-card">
                <div class="ims-staff-section-header">
                    <h3>Upcoming SLA Deadlines</h3>
                </div>
                <div class="ims-staff-table-container">
                    <table class="ims-staff-data-table">
                        <thead>
                            <tr>
                                <th>Idea</th>
                                <th>Reviewer</th>
                                <th>Deadline</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deadline in Model.SLADeadlines)
                            {
                                <tr>
                                    <td>@deadline.Idea</td>
                                    <td>@deadline.Reviewer</td>
                                    <td>@deadline.Deadline.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="ims-staff-sla-status ims-staff-sla-@deadline.StatusClass">
                                            @deadline.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

</body>
