
<!DOCTYPE html>
<html lang="en" data-coreui-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Template.Web</title>
    <link rel="stylesheet" href="~/css/font_awesome_all.min.css" asp-append-version="true" />
