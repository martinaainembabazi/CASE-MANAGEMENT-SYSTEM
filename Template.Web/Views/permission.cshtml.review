@page
@model PermissionsModel
@{
    ViewData["Title"] = "Permissions - Innovation Management System";
}

<body class="ims-staff-dashboard">
    

    <!-- Main Content -->
    <div class="ims-staff-main-wrapper">
    
        <!-- Main Content Area -->
        <main class="ims-staff-main-content">
            <!-- Filters Bar -->
            <div class="ims-staff-filters-bar">
                <input type="text" class="ims-staff-form-control ims-staff-search-input" placeholder="Search users by name or email..." asp-for="SearchTerm">
                <select class="ims-staff-form-control" asp-for="RoleFilter" style="min-width:150px;">
                    <option value="">All Roles</option>
                    <option value="IT Admin">IT Admin</option>
                    <option value="Innovation Manager">Innovation Manager</option>
                    <option value="Innovation Officer">Innovation Officer</option>
                    <option value="Staff">Staff</option>
                </select>
                <button class="ims-staff-btn ims-staff-btn-primary ims-staff-btn-sm" asp-page-handler="ApplyFilters">Apply</button>
            </div>

            <!-- Permissions Table -->
            <div class="ims-staff-card ims-staff-table-card">
                <div class="ims-staff-table-container">
                    <table class="ims-staff-data-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Department</th>
                                <th>Current Role</th>
                                <th>Permissions</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td><strong>@user.Name</strong></td>
                                    <td>@user.Email</td>
                                    <td>@user.Department</td>
                                    <td>@user.Role</td>
                                    <td>
                                        <div class="ims-staff-permission-tags">
                                            @foreach (var permission in user.Permissions)
                                            {
                                                <span class="ims-staff-permission-tag">@permission</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="ims-staff-actions">
                                            <button class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-secondary" onclick="editPermissions(@user.Id)">Edit</button>
                                            @if (user.IsActive)
                                            {
                                                <button class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-danger" onclick="disableUser(@user.Id)">Disable</button>
                                            }
                                            else
                                            {
                                                <button class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-success" onclick="activateUser(@user.Id)">Activate</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="ims-staff-pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-page="/Innovation/Permissions" asp-route-page="@(Model.CurrentPage - 1)" class="ims-staff-pagination-link">&laquo; Previous</a>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-page="/Innovation/Permissions" asp-route-page="@i" class="ims-staff-pagination-link @(i == Model.CurrentPage ? "ims-staff-pagination-active" : "")">@i</a>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-page="/Innovation/Permissions" asp-route-page="@(Model.CurrentPage + 1)" class="ims-staff-pagination-link">Next &raquo;</a>
                        }
                    </div>
                }
            </div>
        </main>
    </div>

    <!-- Edit Permissions Modal -->
    <div class="ims-staff-modal" id="permissionsModal" style="display:none;">
        <div class="ims-staff-modal-overlay" onclick="closePermissionsModal()"></div>
        <div class="ims-staff-modal-content" style="max-width:550px;">
            <div class="ims-staff-modal-header">
                <h3 id="permissionsModalTitle">Edit Permissions</h3>
                <button class="ims-staff-modal-close" onclick="closePermissionsModal()">&times;</button>
            </div>
            <form method="post" asp-page-handler="UpdatePermissions">
                <input type="hidden" asp-for="SelectedUser.Id" id="selectedUserId">
                <div class="ims-staff-modal-body">
                    <div class="ims-staff-form-group">
                        <label>User</label>
                        <p class="ims-staff-user-display" id="selectedUserName">Jane Mukasa</p>
                    </div>
                    <div class="ims-staff-form-group">
                        <label>Role</label>
                        <select class="ims-staff-form-control" asp-for="SelectedUser.Role">
                            <option value="IT Admin">IT Admin</option>
                            <option value="Innovation Manager">Innovation Manager</option>
                            <option value="Innovation Officer">Innovation Officer</option>
                            <option value="Staff">Staff</option>
                        </select>
                    </div>
                    <div class="ims-staff-form-group">
                        <label>Permissions</label>
                        <div class="ims-staff-permission-checkboxes">
                            <label><input type="checkbox" name="SelectedUser.Permissions" value="Submit Ideas"> Submit Ideas</label>
                            <label><input type="checkbox" name="SelectedUser.Permissions" value="View Resources"> View Resources</label>
                            <label><input type="checkbox" name="SelectedUser.Permissions" value="Review"> Review</label>
                            <label><input type="checkbox" name="SelectedUser.Permissions" value="Comment"> Comment</label>
                            <label><input type="checkbox" name="SelectedUser.Permissions" value="Approve"> Approve</label>
                            <label><input type="checkbox" name="SelectedUser.Permissions" value="Manage Categories"> Manage Categories</label>
                            <label><input type="checkbox" name="SelectedUser.Permissions" value="Full System Access"> Full System Access</label>
                            <label><input type="checkbox" name="SelectedUser.Permissions" value="Manage Users"> Manage Users</label>
                            <label><input type="checkbox" name="SelectedUser.Permissions" value="View Reports"> View Reports</label>
                            <label><input type="checkbox" name="SelectedUser.Permissions" value="Export Data"> Export Data</label>
                        </div>
                    </div>
                    <div class="ims-staff-form-group">
                        <label>Account Status</label>
                        <select class="ims-staff-form-control" asp-for="SelectedUser.IsActive">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="ims-staff-modal-footer">
                    <button type="button" class="ims-staff-btn ims-staff-btn-secondary" onclick="closePermissionsModal()">Cancel</button>
                    <button type="submit" class="ims-staff-btn ims-staff-btn-primary">Save Permissions</button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script src="https://unpkg.com/lucide@latest"></script>
        <script>
            lucide.createIcons();

            function editPermissions(id) {
                // Fetch user data via AJAX or load from model
                // For now, redirect to edit handler
                window.location.href = `/Innovation/Permissions?handler=Edit&id=${id}`;
            }

            function activateUser(id) {
                if (confirm('Are you sure you want to activate this user?')) {
                    window.location.href = `/Innovation/Permissions?handler=Activate&id=${id}`;
                }
            }

            function disableUser(id) {
                if (confirm('Are you sure you want to disable this user?')) {
                    window.location.href = `/Innovation/Permissions?handler=Disable&id=${id}`;
                }
            }

            function closePermissionsModal() {
                document.getElementById('permissionsModal').style.display = 'none';
                document.body.style.overflow = 'auto';
            }

            // Close modal on ESC key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closePermissionsModal();
                }
            });
        </script>
    }
</body>