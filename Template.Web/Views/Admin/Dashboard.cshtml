@model Template.Core.Models.Account.ITSupportDashboardViewModel
@{
    ViewData["Title"] = "IT Support Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">IT Support Overview</h3>
        <p class="text-muted mb-0">System health, account provisions, and contract activity</p>
    </div>
</div>

<!-- Key Performance Metrics Row -->
<div class="row g-3 mb-4">
    <div class="col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small fw-semibold">TOTAL USERS</div>
            <div class="fs-2 fw-bold text-dark mt-1">@Model.TotalUsers</div>
        </div>
    </div>
    <div class="col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small fw-semibold">ACTIVE USERS</div>
            <div class="fs-2 fw-bold text-success mt-1">@Model.ActiveUsers</div>
        </div>
    </div>
    <div class="col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small fw-semibold">LOCKED ACCOUNTS</div>
            <div class="fs-2 fw-bold text-danger mt-1">@Model.LockedUsers</div>
        </div>
    </div>
    <div class="col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small fw-semibold">LAW FIRMS</div>
            <div class="fs-2 fw-bold text-dark mt-1">@Model.TotalLawFirms</div>
        </div>
    </div>
    <div class="col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small fw-semibold">ACTIVE CONTRACTS</div>
            <div class="fs-2 fw-bold text-primary mt-1">@Model.ActiveLawFirmContracts</div>
        </div>
    </div>
    <div class="col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small fw-semibold">EXPIRED CONTRACTS</div>
            <div class="fs-2 fw-bold text-warning mt-1">@Model.ExpiredLawFirmContracts</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent System Users -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="ti ti-users me-2"></i>Recently Added Users</h5>
                <a asp-controller="Account" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Username</th>
                                <th>Assigned Roles</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.RecentUsers)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@user.UserName</div>
                                        <div class="text-muted small">@user.Email</div>
                                    </td>
                                    <td>
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@role</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(user.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                            @(user.IsActive ? "Active" : "Locked")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-controller="Account" asp-action="Update" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Audit Logs -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="ti ti-history me-2"></i>System Activity Trail</h5>
                <a asp-controller="Audit" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View Trail</a>
            </div>
            <div class="card-body">
                @if (!Model.RecentAuditLogs.Any())
                {
                    <p class="text-muted text-center py-4">No recent activity logged.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <li class="list-group-item px-0 py-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark">@log.Action</span>
                                    <span class="text-muted small">@log.Timestamp.ToString("dd MMM HH:mm")</span>
                                </div>
                                <div class="small text-muted mb-1">@log.Details</div>
                                <div class="badge bg-light text-secondary">By: @log.PerformedBy</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>