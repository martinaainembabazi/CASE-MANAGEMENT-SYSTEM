@model Template.Core.Models.Account.ITSupportDashboardViewModel
@{
    ViewData["Title"] = "IT Support Dashboard";
}

<div class="container-fluid px-4 py-3">
    <!-- Top Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark"><i class="ti ti-headset me-2 text-danger"></i>IT Support Overview</h3>
            <p class="text-muted mb-0">System health, account provisions, and contract activity</p>
        </div>
    </div>

    <!-- Key Performance Metrics Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm p-3 text-center h-100 bou-metric-card d-flex flex-column justify-content-between">
                <span class="text-muted fs-8 fw-bold text-uppercase">TOTAL USERS</span>
                <div class="fw-bold text-dark mt-auto pb-1" style="font-size: 2.25rem !important; line-height: 1;">@Model.TotalUsers</div>
            </div>
        </div>
        <div class="col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm p-3 text-center h-100 bou-metric-card d-flex flex-column justify-content-between">
                <span class="text-muted fs-8 fw-bold text-uppercase">ACTIVE USERS</span>
                <div class="fw-bold text-success mt-auto pb-1" style="font-size: 2.25rem !important; line-height: 1;">@Model.ActiveUsers</div>
            </div>
        </div>
        <div class="col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm p-3 text-center h-100 bou-metric-card d-flex flex-column justify-content-between">
                <span class="text-muted fs-8 fw-bold text-uppercase">LOCKED ACCOUNTS</span>
                <div class="fw-bold text-danger mt-auto pb-1" style="font-size: 2.25rem !important; line-height: 1;">@Model.LockedUsers</div>
            </div>
        </div>
        <div class="col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm p-3 text-center h-100 bou-metric-card d-flex flex-column justify-content-between">
                <span class="text-muted fs-8 fw-bold text-uppercase">LAW FIRMS</span>
                <div class="fw-bold text-dark mt-auto pb-1" style="font-size: 2.25rem !important; line-height: 1;">@Model.TotalLawFirms</div>
            </div>
        </div>
        <div class="col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm p-3 text-center h-100 bou-metric-card d-flex flex-column justify-content-between">
                <span class="text-muted fs-8 fw-bold text-uppercase">ACTIVE CONTRACTS</span>
                <div class="fw-bold text-primary mt-auto pb-1" style="font-size: 2.25rem !important; line-height: 1;">@Model.ActiveLawFirmContracts</div>
            </div>
        </div>
        <div class="col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm p-3 text-center h-100 bou-metric-card d-flex flex-column justify-content-between">
                <span class="text-muted fs-8 fw-bold text-uppercase">EXPIRED CONTRACTS</span>
                <div class="fw-bold text-warning mt-auto pb-1" style="font-size: 2.25rem !important; line-height: 1;">@Model.ExpiredLawFirmContracts</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent System Users -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark"><i class="ti ti-users me-2 text-danger"></i>Recently Added Users</h6>
                    <a asp-controller="Account" asp-action="Index" class="btn btn-sm btn-link text-danger text-decoration-none fw-semibold fs-8">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 custom-report-table">
                            <thead class="bg-light text-uppercase fs-8 text-muted border-bottom">
                                <tr>
                                    <th class="ps-3 py-2">Username</th>
                                    <th class="py-2">Assigned Roles</th>
                                    <th class="py-2">Status</th>
                                    <th class="pe-3 py-2 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.RecentUsers)
                                {
                                    <tr>
                                        <td class="ps-3 py-2">
                                            <div class="fw-bold text-dark fs-7">@user.UserName</div>
                                            <div class="text-muted fs-8">@user.Email</div>
                                        </td>
                                        <td class="py-2">
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge border border-subtle bg-light text-secondary fw-normal fs-8 me-1" style="font-size: 0.725rem !important;">
                                                    @role
                                                </span>
                                            }
                                        </td>
                                        <td class="py-2">
                                            <span class="badge @(user.IsActive ? "badge-soft-success" : "badge-soft-danger") px-2 py-1 fs-8 fw-normal">
                                                @(user.IsActive ? "Active" : "Locked")
                                            </span>
                                        </td>
                                        <td class="pe-3 py-2 text-end">
                                            <a asp-controller="Account" asp-action="Update" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary px-2 py-1 fs-8 shadow-sm">
                                                <i class="ti ti-edit me-1"></i>Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Audit Logs -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark"><i class="ti ti-history me-2 text-danger"></i>System Activity Trail</h6>
                    <a asp-controller="Audit" asp-action="Index" class="btn btn-sm btn-link text-danger text-decoration-none fw-semibold fs-8">View Trail</a>
                </div>
                <div class="card-body pt-0">
                    @if (!Model.RecentAuditLogs.Any())
                    {
                        <p class="text-muted text-center py-4 fs-7">No recent activity logged.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var log in Model.RecentAuditLogs)
                            {
                                <div class="p-2 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-semibold text-dark fs-7">@log.Action</span>
                                        <span class="text-muted fs-8">@log.Timestamp.ToString("dd MMM HH:mm")</span>
                                    </div>
                                    <div class="fs-8 text-muted mb-1">@log.Details</div>
                                    <span class="badge border border-subtle bg-light text-secondary fw-normal fs-8" style="font-size: 0.725rem !important;">
                                        By: @log.PerformedBy
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style type="text/css">
        .fs-7 {
            font-size: 0.825rem !important;
        }

        .fs-8 {
            font-size: 0.75rem !important;
        }

        .bou-metric-card {
            border-radius: 10px;
            background-color: #ffffff;
        }

        .badge-soft-success {
            background-color: #ecfdf5;
            color: #065f46;
        }

        .badge-soft-danger {
            background-color: #fef2f2;
            color: #991b1b;
        }

        .custom-report-table td,
        .custom-report-table th {
            padding-top: 0.4rem !important;
            padding-bottom: 0.4rem !important;
            padding-left: 0.5rem !important;
            padding-right: 0.5rem !important;
            vertical-align: middle;
        }
    </style>
}