@model Template.Core.Models.Report.LegalReportViewModel
@{
    ViewData["Title"] = "Legal Cases & Matters Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="ti ti-file-analytics me-2"></i>Legal Operations Report</h3>
        <p class="text-muted mb-0">Monthly & Bi-Annual summary for internal, external, and other legal matters</p>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary">
        <i class="ti ti-printer me-1"></i> Print / Export PDF
    </button>
</div>

<!-- Filters Card (CASMS-REQ-070 & 080) -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label asp-for="Filter.Frequency" class="form-label small fw-semibold"></label>
                <select asp-for="Filter.Frequency" class="form-select">
                    <option value="Monthly">Monthly</option>
                    <option value="BiAnnual">Bi-Annual (6 Months)</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.ManagementType" class="form-label small fw-semibold"></label>
                <select asp-for="Filter.ManagementType" class="form-select">
                    <option value="All">All Types</option>
                    <option value="Internal">Internal Matters</option>
                    <option value="External">External Matters</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.Status" class="form-label small fw-semibold"></label>
                <select asp-for="Filter.Status" class="form-select">
                    <option value="All">All Statuses</option>
                    <option value="Outstanding">Outstanding</option>
                    <option value="Concluded">Concluded</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.StartDate" class="form-label small fw-semibold">Start Date</label>
                <input asp-for="Filter.StartDate" class="form-control" type="date" />
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.EndDate" class="form-label small fw-semibold">End Date</label>
                <input asp-for="Filter.EndDate" class="form-control" type="date" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-danger w-100">
                    <i class="ti ti-filter me-1"></i> Generate
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Metrics Summary Cards (CASMS-REQ-065 & 080) -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <span class="text-muted small fw-semibold">TOTAL CASES HANDLED</span>
            <span class="fs-3 fw-bold text-dark mt-1">@Model.TotalCasesHandled</span>
            <div class="small text-muted mt-1">
                <span class="text-danger fw-semibold">@Model.OutstandingCasesCount</span> Outstanding |
                <span class="text-success fw-semibold">@Model.ConcludedCasesCount</span> Concluded
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <span class="text-muted small fw-semibold">TOTAL AMOUNT CLAIMED</span>
            <span class="fs-3 fw-bold text-dark mt-1">UGX @Model.TotalClaimedAmount.ToString("N0")</span>
            <span class="small text-muted mt-1">Aggregate claimed in litigation</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <span class="text-muted small fw-semibold">LEGAL FEES & DISBURSEMENTS</span>
            <span class="fs-3 fw-bold text-primary mt-1">UGX @Model.TotalCosts.ToString("N0")</span>
            <div class="small text-muted mt-1">
                Fees: @Model.TotalLegalFeesPaid.ToString("N0") | Disb: @Model.TotalDisbursementsPaid.ToString("N0")
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3">
            <span class="text-muted small fw-semibold">REPORT RANGE</span>
            <span class="fs-6 fw-bold text-dark mt-2">
                @(Model.Filter.StartDate?.ToString("dd MMM yyyy")) - @(Model.Filter.EndDate?.ToString("dd MMM yyyy"))
            </span>
            <span class="badge bg-light text-dark border mt-2 align-self-start">@Model.Filter.Frequency</span>
        </div>
    </div>
</div>

<!-- Itemized Table (CASMS-REQ-065 & 081) -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">Itemized Matters & Case Assessments</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th>Case Ref & Title</th>
                        <th>Mgmt Type</th>
                        <th>Probability of Success</th>
                        <th>Claimed Amount</th>
                        <th>Fees & Disbursements</th>
                        <th>Next Hearing</th>
                        <th>Status Update</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ReportRows.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No cases match the selected filter criteria.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.ReportRows)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@item.CaseNumber</div>
                                    <div class="small text-muted">@item.CaseTitle</div>
                                    <span class="badge bg-light text-secondary border mt-1">@item.CaseCategory</span>
                                </td>
                                <td>
                                    <span class="badge @(item.ManagementType == "Internal" ? "bg-info-subtle text-info" : "bg-warning-subtle text-warning")">
                                        @item.ManagementType
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark">
                                        @item.SuccessProbability
                                    </span>
                                </td>
                                <td>UGX @item.ClaimedAmount.ToString("N0")</td>
                                <td>
                                    <div class="fw-semibold">UGX @item.TotalCost.ToString("N0")</div>
                                    <div class="small text-muted">Fees: @item.LegalFees.ToString("N0") | Disb: @item.Disbursements.ToString("N0")</div>
                                </td>
                                <td>
                                    <div class="small text-dark text-truncate" style="max-width: 200px;" title="@item.LatestStatusUpdate">
                                        @item.LatestStatusUpdate
                                    </div>
                                    <div class="small text-muted fs-7">@item.LastUpdated.ToString("dd MMM yyyy")</div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>