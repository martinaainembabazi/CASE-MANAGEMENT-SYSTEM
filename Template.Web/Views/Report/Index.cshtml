@model Template.Core.Models.Report.LegalReportViewModel
@{
    ViewData["Title"] = "Legal Cases & Matters Report";
}

<!-- Top Header & Action Buttons -->
<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="ti ti-file-analytics me-2 text-danger"></i>Legal Operations Report</h3>
        <p class="text-muted mb-0">Monthly & Bi-Annual summary for internal, external, and other legal matters</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary px-3">
            <i class="ti ti-printer me-1"></i> Print
        </button>
        <button id="downloadPdfBtn" onclick="downloadReportPDF()" class="btn btn-danger shadow-sm px-3">
            <i class="ti ti-file-download me-1"></i> Save as PDF
        </button>
    </div>
</div>

<!-- Filters Card -->
<div class="card border-0 shadow-sm mb-4 d-print-none" style="border-radius: 12px;">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label asp-for="Filter.Frequency" class="form-label small fw-bold text-uppercase text-muted mb-1"></label>
                <select asp-for="Filter.Frequency" class="form-select form-select-sm border-light-subtle">
                    <option value="Monthly">Monthly</option>
                    <option value="BiAnnual">Bi-Annual (6 Months)</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.ManagementType" class="form-label small fw-bold text-uppercase text-muted mb-1"></label>
                <select asp-for="Filter.ManagementType" class="form-select form-select-sm border-light-subtle">
                    <option value="All">All Types</option>
                    <option value="Internal">Internal Matters</option>
                    <option value="External">External Matters</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.Status" class="form-label small fw-bold text-uppercase text-muted mb-1"></label>
                <select asp-for="Filter.Status" class="form-select form-select-sm border-light-subtle">
                    <option value="All">All Statuses</option>
                    <option value="Outstanding">Outstanding</option>
                    <option value="Concluded">Concluded</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.StartDate" class="form-label small fw-bold text-uppercase text-muted mb-1">Start Date</label>
                <input asp-for="Filter.StartDate" class="form-control form-control-sm border-light-subtle" type="date" />
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.EndDate" class="form-label small fw-bold text-uppercase text-muted mb-1">End Date</label>
                <input asp-for="Filter.EndDate" class="form-control form-control-sm border-light-subtle" type="date" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-danger btn-sm w-100 shadow-sm">
                    <i class="ti ti-filter me-1"></i> Generate
                </button>
            </div>
        </form>
    </div>
</div>

<!-- PRINT / PDF CONTAINER STARTS HERE -->
<div id="reportContent" class="p-2 bg-white">

    <!-- PDF & PRINT ONLY HEADER -->
    <div class="d-none d-print-block mb-4 text-center">
        <h2 class="fw-bold text-dark mb-1">BANK OF UGANDA - LEGAL OPERATIONS REPORT</h2>
        <p class="text-muted small mb-0">Generated on: @DateTime.Now.ToString("dd MMMM yyyy HH:mm")</p>
        <hr class="my-3" />
    </div>

    <!-- Metrics Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100 bou-report-card">
                <span class="text-muted fs-7 fw-bold text-uppercase tracking-wide">TOTAL CASES HANDLED</span>
                <h3 class="fw-bold text-dark mt-2 mb-1">@Model.TotalCasesHandled</h3>
                <div class="fs-7 text-muted mt-auto pt-2">
                    <span class="badge badge-soft-warning px-2 py-1 me-1">@Model.OutstandingCasesCount Outstanding</span>
                    <span class="badge badge-soft-success px-2 py-1">@Model.ConcludedCasesCount Concluded</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100 bou-report-card">
                <span class="text-muted fs-7 fw-bold text-uppercase tracking-wide">TOTAL AMOUNT CLAIMED</span>
                <h4 class="fw-bold text-dark mt-2 mb-1">UGX @Model.TotalClaimedAmount.ToString("N0")</h4>
                <span class="fs-7 text-muted mt-auto pt-2">Aggregate claimed in litigation</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100 bou-report-card">
                <span class="text-muted fs-7 fw-bold text-uppercase tracking-wide">LEGAL FEES & DISBURSEMENTS</span>
                <h4 class="fw-bold text-dark mt-2 mb-1">UGX @Model.TotalCosts.ToString("N0")</h4>
                <div class="fs-7 text-muted mt-auto pt-2">
                    Fees: <strong class="text-dark">@Model.TotalLegalFeesPaid.ToString("N0")</strong> | Disb: <strong class="text-dark">@Model.TotalDisbursementsPaid.ToString("N0")</strong>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100 bou-report-card">
                <span class="text-muted fs-7 fw-bold text-uppercase tracking-wide">REPORT RANGE</span>
                <div class="fw-bold text-dark fs-6 mt-2">
                    @(Model.Filter.StartDate?.ToString("dd MMM yyyy")) - @(Model.Filter.EndDate?.ToString("dd MMM yyyy"))
                </div>
                <div class="mt-auto pt-2">
                    <span class="badge badge-soft-secondary px-3 py-1">@Model.Filter.Frequency</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Itemized Table Card -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-header bg-white py-3 border-bottom-0">
            <h6 class="fw-bold mb-0 text-dark">Itemized Matters & Case Assessments</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 custom-report-table">
                    <thead class="bg-light text-uppercase fs-8 text-muted border-bottom">
                        <tr>
                            <th class="ps-3 py-2">Case Ref & Title</th>
                            <th class="py-2">Mgmt Type</th>
                            <th class="py-2">Probability</th>
                            <th class="py-2">Claimed Amount</th>
                            <th class="py-2">Fees & Disbursements</th>
                            <th class="py-2">Next Hearing</th>
                            <th class="pe-3 py-2">Status Update</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ReportRows.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted fs-7">No cases match the selected filter criteria.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.ReportRows)
                            {
                                var mgmtBadge = item.ManagementType.StartsWith("Internal") ? "badge-soft-info" : "badge-soft-warning";

                                <tr>
                                    <td class="ps-3 py-2">
                                        <div class="fw-bold text-dark fs-7">@item.CaseNumber</div>
                                        <div class="text-muted fs-8">@item.CaseTitle</div>
                                        <span class="badge border border-subtle bg-light text-secondary fw-normal mt-1" style="font-size: 0.725rem !important;">
                                            @item.CaseCategory
                                        </span>
                                    </td>
                                    <td class="py-2">
                                        <span class="badge @mgmtBadge px-2 py-1 fs-8 fw-normal">
                                            @item.ManagementType
                                        </span>
                                    </td>
                                    <td class="py-2">
                                        <span class="badge badge-soft-secondary px-2 py-1 fs-8 fw-normal">
                                            @item.SuccessProbability
                                        </span>
                                    </td>
                                    <td class="py-2 fw-semibold text-dark fs-7">
                                        UGX @item.ClaimedAmount.ToString("N0")
                                    </td>
                                    <td class="py-2">
                                        <div class="fw-bold text-dark fs-7">UGX @item.TotalCost.ToString("N0")</div>
                                        <div class="fs-8 text-muted">Fees: @item.LegalFees.ToString("N0") | Disb: @item.Disbursements.ToString("N0")</div>
                                    </td>
                                    <td class="py-2 fs-7 text-dark">
                                        @(item.NextHearingDate?.ToString("dd MMM yyyy") ?? "N/A")
                                    </td>
                                    <td class="pe-3 py-2">
                                        <div class="fs-7 text-dark text-truncate" style="max-width: 200px;" title="@item.LatestStatusUpdate">
                                            @item.LatestStatusUpdate
                                        </div>
                                        <div class="fs-8 text-muted">Updated: @item.LastUpdated.ToString("dd MMM yyyy")</div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        function downloadReportPDF() {
            const element = document.getElementById('reportContent');
            const btn = document.getElementById('downloadPdfBtn');

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Exporting...';

            const opt = {
                margin: [10, 10, 10, 10],
                filename: `Legal_Operations_Report_${new Date().toISOString().slice(0, 10)}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };

            html2pdf().set(opt).from(element).save().then(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="ti ti-file-download me-1"></i> Save as PDF';
            });
        }
    </script>
}

@section Styles {
    <style type="text/css">
        .fs-7 {
            font-size: 0.8rem !important;
        }

        .fs-8 {
            font-size: 0.725rem !important;
        }

        .bou-report-card {
            border-radius: 10px;
            background-color: #ffffff;
        }

        .badge-soft-primary {
            background-color: #eef2ff;
            color: #3730a3;
        }

        .badge-soft-success {
            background-color: #ecfdf5;
            color: #065f46;
        }

        .badge-soft-warning {
            background-color: #fffbeb;
            color: #92400e;
        }

        .badge-soft-info {
            background-color: #f0f9ff;
            color: #075985;
        }

        .badge-soft-secondary {
            background-color: #f8fafc;
            color: #475569;
        }

        .custom-report-table td,
        .custom-report-table th {
            padding-top: 0.4rem !important;
            padding-bottom: 0.4rem !important;
            padding-left: 0.5rem !important;
            padding-right: 0.5rem !important;
            vertical-align: middle;
        }

        @@media print {
            .left-sidebar,
            .topbar,
            .d-print-none,
            header,
            nav {
                display: none !important;
            }

            .body-wrapper,
            .container-fluid,
            body {
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                width: 100% !important;
            }

            .card {
                border: 1px solid #dee2e6 !important;
                box-shadow: none !important;
            }

            .table {
                width: 100% !important;
            }

                .table th, .table td {
                    font-size: 8pt !important;
                    padding: 4px !important;
                }
        }
    </style>
}