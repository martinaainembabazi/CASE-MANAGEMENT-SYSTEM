@model IEnumerable<Template.Data.Entities.CaseAssignment>
@{
    ViewData["Title"] = "Law Firm Portal";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="ti ti-building-bank me-2 text-danger"></i>Law Firm Portal
            </h3>
            <p class="text-muted mb-0">Legal Partner Portal & Assigned Case Overview</p>
        </div>
    </div>

    <!-- Metrics Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center h-100 bou-metric-card d-flex flex-column justify-content-between">
                <span class="text-muted fs-8 fw-bold text-uppercase">TOTAL ASSIGNED CASES</span>
                <div class="fw-bold text-dark mt-auto pb-1" style="font-size: 2.25rem !important; line-height: 1;">
                    @Model.Count()
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center h-100 bou-metric-card d-flex flex-column justify-content-between">
                <span class="text-muted fs-8 fw-bold text-uppercase">ACTIVE CASES</span>
                <div class="fw-bold text-primary mt-auto pb-1" style="font-size: 2.25rem !important; line-height: 1;">
                    @Model.Count(a => a.Case?.Status?.Name != "Closed")
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center h-100 bou-metric-card d-flex flex-column justify-content-between">
                <span class="text-muted fs-8 fw-bold text-uppercase">CLOSED CASES</span>
                <div class="fw-bold text-success mt-auto pb-1" style="font-size: 2.25rem !important; line-height: 1;">
                    @Model.Count(a => a.Case?.Status?.Name == "Closed")
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="ti ti-gavel me-2 text-danger"></i>Assigned Matters
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 custom-report-table">
                            <thead class="bg-light text-uppercase fs-8 text-muted border-bottom">
                                <tr>
                                    <th class="ps-3 py-2">Ref No</th>
                                    <th class="py-2">Case Title</th>
                                    <th class="py-2">Type</th>
                                    <th class="py-2">Status</th>
                                    <th class="pe-3 py-2 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted fs-7">No cases currently assigned.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="py-2">
                                                <div class="fw-semibold text-dark fs-7">@item.Case?.Title</div>
                                                <div class="text-muted fs-8">Assigned: @item.AssignedDate.ToString("dd MMM yyyy")</div>
                                            </td>
                                            <td class="py-2 fs-8 text-muted">@item.Case?.Type?.Name</td>
                                            <td class="py-2">
                                                <span class="badge badge-soft-primary px-2 py-1 fs-8 fw-normal">
                                                    @(item.Case?.Status?.Name ?? "Pending")
                                                </span>
                                            </td>
                                            <td class="pe-3 py-2 text-end">
                                                <a asp-controller="Cases" asp-action="Details" asp-route-id="@item.CaseId" class="btn btn-sm btn-outline-secondary px-2 py-1 fs-8 shadow-sm">
                                                    <i class="ti ti-eye me-1"></i>View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style type="text/css">
        .fs-7 {
            font-size: 0.825rem !important;
        }

        .fs-8 {
            font-size: 0.75rem !important;
        }

        .bou-metric-card {
            border-radius: 10px;
            background-color: #ffffff;
        }

        .badge-soft-success {
            background-color: #ecfdf5;
            color: #065f46;
        }

        .badge-soft-danger {
            background-color: #fef2f2;
            color: #991b1b;
        }

        .badge-soft-primary {
            background-color: #eff6ff;
            color: #1e40af;
        }

        .custom-report-table td,
        .custom-report-table th {
            padding-top: 0.4rem !important;
            padding-bottom: 0.4rem !important;
            padding-left: 0.5rem !important;
            padding-right: 0.5rem !important;
            vertical-align: middle;
        }
    </style>
}