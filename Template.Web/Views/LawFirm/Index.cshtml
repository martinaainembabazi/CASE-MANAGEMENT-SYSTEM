@model IEnumerable<Template.Core.Models.LawFirm.LawFirmViewModel>

@{
    ViewData["Title"] = "Law Firms";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold text-danger mb-0">Law Firms & External Counsel</h3>
            <p class="text-muted mb-0">Manage external law firms, active retainer contracts, and advocate rosters.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-danger">
                <i class="ti ti-plus me-1"></i> Register Law Firm
            </a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle datatable">
                <thead class="table-light">
                    <tr>
                        <th>Firm Name</th>
                        <th>Email & Phone</th>
                        <th>Contract Period</th>
                        <th>Lawyers</th>
                        <th>Active Cases</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusBadge = item.Status.ToLower() switch
                        {
                            "active" => "bg-success",
                            "suspended" => "bg-warning text-dark",
                            "terminated" or "inactive" => "bg-secondary",
                            _ => "bg-primary"
                        };

                        <tr>
                            <td>
                                <span class="fw-bold text-dark d-block">@item.Name</span>
                                <small class="text-muted">@(item.Address ?? "No address recorded")</small>
                            </td>
                            <td>
                                <div><small class="fw-semibold">@(item.Email ?? "N/A")</small></div>
                                <small class="text-muted">@(item.Phone ?? "N/A")</small>
                            </td>
                            <td>
                                <small class="d-block"><strong>Start:</strong> @item.ContractStartDate.ToString("yyyy-MM-dd")</small>
                                <small class="text-muted"><strong>End:</strong> @(item.ContractEndDate.HasValue ? item.ContractEndDate.Value.ToString("yyyy-MM-dd") : "Ongoing")</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.TotalLawyersCount Lawyers</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-danger border">@item.TotalCaseAssignmentsCount Cases</span>
                            </td>
                            <td>
                                <span class="badge @statusBadge">@item.Status</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="ti ti-eye"></i>Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit Firm">
                                        <i class="ti ti-edit"></i>Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Deactivate Firm">
                                        <i class="ti ti-trash"></i>Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>