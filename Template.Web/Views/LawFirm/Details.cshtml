@model Template.Core.Models.LawFirm.LawFirmViewModel

@{
    ViewData["Title"] = "Law Firm Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-danger mb-0">@Model.Name</h3>
        <p class="text-muted mb-0">Law Firm Profile and Details</p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="ti ti-edit me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-light ms-1">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3">Contact Summary</h5>
                <p class="mb-2"><strong>Email:</strong> @(Model.Email ?? "N/A")</p>
                <p class="mb-2"><strong>Phone:</strong> @(Model.Phone ?? "N/A")</p>
                <p class="mb-2"><strong>Status:</strong> <span class="badge bg-success">@Model.Status</span></p>
                <p class="mb-0"><strong>Address:</strong> @(Model.Address ?? "N/A")</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3">Retainer & Contract Info</h5>
                <div class="row g-3">
                    <div class="col-6">
                        <small class="text-muted d-block">Contract Start</small>
                        <span class="fw-semibold">@Model.ContractStartDate.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Contract End</small>
                        <span class="fw-semibold">@(Model.ContractEndDate.HasValue ? Model.ContractEndDate.Value.ToString("yyyy-MM-dd") : "Ongoing Retainer")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Total Lawyers Assigned</small>
                        <span class="badge bg-light text-dark border">@Model.TotalLawyersCount Advocates</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Assigned Cases</small>
                        <span class="badge bg-light text-danger border">@Model.TotalCaseAssignmentsCount Cases</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>